{
    "name": "@openaddresses/deploy",
    "type": "module",
    "version": "10.10.1",
    "main": "dist/cli.js",
    "types": "dist/cli.d.ts",
    "author": "ingalls <nick@ingalls.ca>",
    "license": "MIT",
    "scripts": {
        "build": "tsc -p tsconfig.json && cp -r data dist/ && cp package.json dist/",
        "postbuild": "chmod +x dist/cli.js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives",
        "test": "vitest run",
        "prepack": "npm run build"
    },
    "bin": {
        "deploy": "dist/cli.js"
    },
    "engines": {
        "node": "> 21"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/openaddresses/deploy.git"
    },
    "dependencies": {
        "@aws-sdk/client-cloudformation": "^3.272.0",
        "@aws-sdk/client-ec2": "^3.272.0",
        "@aws-sdk/client-ecr": "^3.272.0",
        "@aws-sdk/client-ecs": "^3.272.0",
        "@aws-sdk/client-s3": "^3.272.0",
        "@aws-sdk/client-secrets-manager": "^3.272.0",
        "@aws-sdk/client-sts": "^3.730.0",
        "@aws-sdk/credential-providers": "^3.272.0",
        "@openaddresses/cfn-config": "^9.1.1",
        "ajv": "^8.6.3",
        "cli-table": "^0.3.1",
        "handlebars": "^4.7.7",
        "inquirer": "^14.0.0",
        "ora": "^10.0.0",
        "prompt": "^1.0.0"
    },
    "devDependencies": {
        "@types/cli-table": "^0.3.4",
        "@types/node": "^26.0.0",
        "@types/prompt": "^1.1.8",
        "oxlint": "^1.95.0",
        "oxlint-tsgolint": "^7.0.2009",
        "typescript": "^7.0.2",
        "vitest": "^5.0.0"
    }
}
